---
// Fonts are served from our own domain, so no visitor's IP address goes to Google.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { COMPANY } from '../company';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
}

const { title, description, ogType = 'website', image, publishedTime } = Astro.props;

// Only the build for the prod project may be indexed. Firebase passes the project to the
// predeploy build (firebase.json), so the test site, and any build made without it, says noindex.
const indexable = process.env.GCLOUD_PROJECT === 'egenberedskapsappen';
// Both sites point search engines at the real one.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.site).href : new URL('/favicon.svg', Astro.site).href;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title="Egenberedskapsappen Blogg" href="/blogg/rss.xml" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:site_name" content="Egenberedskapsappen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:image" content={ogImageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#F4F7FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08131F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#innhold">Gå til innholdet</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/">Egenberedskapsappen</a>
        <nav aria-label="Hovedmeny">
          <ul>
            <li><a href="/#regn-ut">Regn ut</a></li>
            <li><a href="/#funksjoner">Funksjoner</a></li>
            <li><a href="/blogg">Blogg</a></li>
            <li><a href="/#personvern">Personvern</a></li>
            <li><a href="/#forsikring">Forsikring</a></li>
            <li><a href="/#sporsmal">Spørsmål</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="innhold">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="wordmark">Egenberedskapsappen</p>
          <p>Gratis app for egenberedskap i norske husstander.</p>
          <p class="foot-links">
            <a href="/blogg">Blogg</a>
            <a href="/kontakt">Kontakt og hjelp</a>
            <a href="/personvern">Personvernerklæring</a>
          </p>
          <p>{COMPANY.name} · Org.nr. {COMPANY.orgNumber}</p>
        </div>
        <p class="small">
          Rådene bygger på Direktoratet for samfunnssikkerhet og beredskap (DSB). Appen er ikke laget av DSB. Se også{' '}
          <a href="https://www.sikkerhverdag.no/" rel="noopener">sikkerhverdag.no</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 10;
    padding: 10px 16px;
    background: var(--card);
    border-radius: 8px;
  }
  .skip:focus {
    top: 12px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--page) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--separator);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;
  }
  .wordmark {
    margin: 0;
    color: var(--label);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.125rem;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--body);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    nav {
      display: none;
    }
  }

  .site-footer {
    margin-top: 40px;
    padding-block: 48px 64px;
    border-top: 1px solid var(--separator);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    font-size: 1rem;
    color: var(--secondary);
  }
  .foot .wordmark {
    margin-bottom: 4px;
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 12px 0;
  }
  .foot-links a {
    color: var(--accent);
    font-weight: 600;
  }
  .small {
    max-width: 44ch;
  }
</style>
