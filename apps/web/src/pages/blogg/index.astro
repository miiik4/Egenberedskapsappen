---
import Base from '../../layouts/Base.astro';
import { BLOG_POSTS } from '../../data/blog';

const title = 'Blogg og guider om egenberedskap – Egenberedskapsappen';
const description =
  'Praktiske råd, veiledninger og kunnskap om hvordan du forbereder hjemmet og familien på strømbrudd, vannstans og kriser.';
---

<Base title={title} description={description}>
  <div class="wrap blog-page">
    <header class="blog-header">
      <div class="badge-wrapper">
        <span class="badge">Egenberedskap i praksis</span>
      </div>
      <h1>Kunnskap og råd for en tryggere hverdag</h1>
      <p class="lead">
        Hva gjør du når strømmen forsvinner, vannet kuttes eller krisen rammer? Våre guider hjelper deg å bygge god
        egenberedskap, basert på offisielle råd fra DSB og erfaringer fra beredskapseksperter.
      </p>
    </header>

    <div class="posts-grid">
      {
        BLOG_POSTS.map((post) => (
          <article class="post-card">
            <div class="post-meta">
              <span class="category">{post.category}</span>
              <span class="meta-dot">·</span>
              <span class="reading-time">{post.readingTime}</span>
            </div>
            <h2>
              <a href={`/blogg/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="excerpt">{post.excerpt}</p>
            <div class="post-footer">
              <time datetime={post.date}>{post.formattedDate}</time>
              <a href={`/blogg/${post.slug}`} class="read-more">
                Les artikkelen
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <section class="banner">
      <div class="banner-content">
        <h2>Hvor godt forberedt er egentlig din husstand?</h2>
        <p>
          Bruk vår gratis beregning til å finne ut nøyaktig hvor mange døgn dere klarer dere selv uten strøm og
          forsyninger.
        </p>
        <a href="/#regn-ut" class="banner-button">Test husstandens beredskap</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .blog-page {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(60px, 10vw, 112px);
  }

  .blog-header {
    max-width: 44rem;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .badge-wrapper {
    margin-bottom: 16px;
  }

  .badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 999px;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-stretch: 110%;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--label);
    margin-bottom: 18px;
  }

  .lead {
    font-size: clamp(1.125rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--secondary);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    box-shadow: 0 4px 12px rgba(11, 43, 74, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(11, 43, 74, 0.08);
    border-color: var(--accent);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    margin-bottom: 14px;
  }

  .category {
    font-weight: 700;
    color: var(--accent);
  }

  .meta-dot {
    color: var(--secondary);
    opacity: 0.5;
  }

  .reading-time {
    color: var(--secondary);
  }

  .post-card h2 {
    font-size: 1.375rem;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .post-card h2 a {
    color: var(--label);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-card h2 a:hover {
    color: var(--accent);
  }

  .excerpt {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--body);
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--separator);
    font-size: 0.875rem;
  }

  .post-footer time {
    color: var(--secondary);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .banner {
    margin-top: clamp(48px, 8vw, 88px);
    padding: clamp(32px, 5vw, 48px);
    background: var(--hero);
    border-radius: 20px;
    color: var(--hero-text);
  }

  .banner-content {
    max-width: 38rem;
  }

  .banner-content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #ffffff;
    margin-bottom: 12px;
  }

  .banner-content p {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--hero-muted);
    margin-bottom: 24px;
  }

  .banner-button {
    display: inline-block;
    padding: 12px 24px;
    background: #ffffff;
    color: var(--hero);
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 10px;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .banner-button:hover {
    background: var(--hero-muted);
    transform: translateY(-1px);
  }
</style>
