{
  "expo": {
    "name": "Egenberedskapsappen",
    "slug": "egenberedskapsappen",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "infoPlist": {
        "CFBundleDisplayName": "Beredskap"
      },
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2B4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg bilder av dokumenter og rom fra bildebiblioteket.",
          "cameraPermission": "Ta bilder og film av dokumenter og rom, s\u00e5 de er tilgjengelige uten nett og innboet er dokumentert.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ta bilder og film av dokumenter og rom, s\u00e5 de er tilgjengelige uten nett og innboet er dokumentert.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bruk Face ID for \u00e5 \u00e5pne dokumentene dine."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Bruk Face ID for \u00e5 \u00e5pne dokumentene dine."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      "./modules/backup-exclusion/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b92cddc0-f00c-4701-b7f9-99dfcf4a2ccc"
      }
    },
    "owner": "mkl96",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b92cddc0-f00c-4701-b7f9-99dfcf4a2ccc"
    }
  }
}
