{
  "expo": {
    "name": "Egenberedskapsappen",
    "slug": "egenberedskapsappen",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "infoPlist": {
        "CFBundleDisplayName": "Beredskap",
        "CFBundleDevelopmentRegion": "nb",
        "CFBundleLocalizations": ["nb"]
      },
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "userInterfaceStyle": "light",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2B4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B2B4A"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg bilder for \u00e5 dokumentere innbo og dokumenter. Bildene sendes ikke noe sted uten at du velger det.",
          "cameraPermission": "Ta bilder og film for \u00e5 dokumentere innbo og dokumenter. Bildene sendes ikke noe sted uten at du velger det.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ta bilder og film for \u00e5 dokumentere innbo og dokumenter. Bildene sendes ikke noe sted uten at du velger det.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bruk Face ID for \u00e5 \u00e5pne dokumentene dine."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Bruk Face ID for \u00e5 \u00e5pne dokumentene dine."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/app-check",
      "./modules/backup-exclusion/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b92cddc0-f00c-4701-b7f9-99dfcf4a2ccc"
      }
    },
    "owner": "mkl96",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b92cddc0-f00c-4701-b7f9-99dfcf4a2ccc"
    }
  }
}
