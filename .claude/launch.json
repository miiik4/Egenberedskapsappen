{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "firma",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "firma",
        "run",
        "dev",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "docs"
      ],
      "port": 8765
    },
    {
      "name": "metro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--workspace",
        "mobile",
        "run",
        "start",
        "--",
        "--dev-client",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
